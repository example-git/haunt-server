# Standalone-binary reverse-proxy example. The 127.0.0.1:8080 upstream below is
# the standalone backend. The prebuilt container instead exposes its bundled
# Nginx on container TCP 80/443 with configurable host-side mappings.
# Put the map and limit zones in nginx's http context.
map $http_upgrade $chatxo_connection {
    default upgrade;
    '' close;
}
limit_req_zone $binary_remote_addr zone=chatxo_auth:1m rate=6r/m;

server {
    listen 443 ssl;
    server_name chat.example.test;
    ssl_certificate /etc/letsencrypt/live/chat.example.test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.test/privkey.pem;
    client_max_body_size 22m;

    # Haunt authenticates, reserves capacity and enforces the live per-file limit.
    location ~ ^/api/v1/conversations/[0-9a-f-]+/attachments$ {
        client_max_body_size 0;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
    location = /api/v1/admin/audio-plugins {
        client_max_body_size 50m;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
    }
    location /api/v1/auth/ {
        limit_req zone=chatxo_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $chatxo_connection;
        proxy_read_timeout 75s;
        proxy_send_timeout 90s;
        proxy_request_buffering off;
    }
}
