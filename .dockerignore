# Explicit build inputs only: never send local secrets, data, private audio
# plugins, Git history, native desktop workers or existing build output.
**
!Dockerfile
!.dockerignore
!go.mod
!go.sum
!webclient_disabled.go
!cmd/**
!internal/**
!deploy/container/**
!client/package.json
!client/package-lock.json
!client/tsconfig.json
!client/vite.config.ts
!client/apps/web/**
!client/packages/**
!client/scripts/**
!client/tests/**
!client/static/icon.*
!client/static/notification-mark.svg
!client/static/icons/**
!client/static/dm-crypto/**
!client/static/api/**
!client/static/updates.json
!client/branding/haunt/**
!client/vendor/twemoji/**
!client/native/dm-crypto/Cargo.*
