# Standalone-binary example only. The server reads the process environment; it
# does not load this file. For the prebuilt container use container.env.example:
# bundled Nginx listens on container TCP 80/443, mapped to host TCP 80/443 by
# default; its internal Haunt backend listens on 127.0.0.1:8080.
# Keep INSTANCE_ID stable for this installation. Generate a UUID when provisioning.
HAUNT_INSTANCE_ID=replace-with-your-instance-uuid
HAUNT_NAME=Haunt
HAUNT_PUBLIC_URL=https://chat.example.test
HAUNT_LISTEN_ADDR=127.0.0.1:8080
# LAN testing: bind 0.0.0.0:8080 and set PUBLIC_URL to http://<private-IP>:8080.
# HTTP is accepted for localhost, loopback and private IPs; public hosts use HTTPS.
HAUNT_DATABASE_URL=postgres://chatxo:replace-this-password@127.0.0.1:5432/chatxo?sslmode=disable
HAUNT_DB_MAX_CONNS=16
# Control pool only; feature pools below are additional (38 total by default).
# HAUNT_DB_MAX_CONNS overrides pool_max_conns in the database URL.
# HAUNT_DB_HISTORY_CONNS=8
# HAUNT_DB_MESSAGES_CONNS=4
# HAUNT_DB_EMBEDS_CONNS=2
# HAUNT_DB_MEDIA_CONNS=2
# HAUNT_DB_REALTIME_CONNS=4
# HAUNT_DB_MAINTENANCE_CONNS=2
# One additional connection belongs to the gateway listener.
# HAUNT_HTTP_QUEUE_WAIT_MS=1000
# HAUNT_HTTP_HISTORY_ACTIVE=128
# HAUNT_HTTP_HISTORY_QUEUED=128
# Each feature has its own ACTIVE and QUEUED limits; see docs/concurrency.md.
# Use encrypted database transport when PostgreSQL is on another host.

# Optional unattended installation; otherwise choose credentials in the setup wizard. Existing owner credentials are never reset
# by these settings. Remove them from the environment after provisioning.
# Username: 3-32 ASCII letters/digits/underscores (stored lowercase).
# Password: at least 8 characters, at most 1024 UTF-8 bytes.
# HAUNT_BOOTSTRAP_USERNAME=owner
# HAUNT_BOOTSTRAP_PASSWORD=replace-with-a-long-random-passphrase
# Prefer a private file for terminal/unattended setup. If both forms are present,
# they must contain the same password.
# HAUNT_BOOTSTRAP_PASSWORD_FILE=/etc/haunt/owner-password
HAUNT_SESSION_DAYS=30
# Each concurrent Argon2id operation uses 64 MiB plus execution overhead.
HAUNT_AUTH_PARALLEL=4

# Enforced messaging/attachment policy. Changes apply on restart.
# Text: decimal MB. Attachment defaults: binary MiB/GiB.
HAUNT_TEXT_MAX_BYTES=256000000
HAUNT_TEXT_RETENTION_DAYS=30
HAUNT_IMAGE_MAX_BYTES=2097152
HAUNT_VIDEO_MAX_BYTES=10485760
HAUNT_ATTACHMENT_MAX_BYTES=1073741824
HAUNT_ATTACHMENT_RETENTION_DAYS=7

# Optional comma-separated browser-client origins, in addition to PUBLIC_URL.
# Leave unset when no additional origins are needed. Wildcards are unsupported.
# HAUNT_CLIENT_ORIGINS=https://client.example.test,https://another-client.example.test
# A browser UI served on the LAN also needs its exact origin here, for example
# HAUNT_CLIENT_ORIGINS=http://192.168.1.117:5173,https://app.chatxo.local

# Persistent local files and actual-content attachment probing.
HAUNT_DATA_DIR=data
HAUNT_FFPROBE=ffprobe

# Trust only explicitly listed proxies. Normal mode reads one X-Forwarded-For
# IP; cloudflared mode reads CF-Connecting-IP from those trusted peers only.
# HAUNT_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Host transport selection; clients consume admissions automatically.
# true + external/Cloudflare TURN: WebRTC through that relay on BOTH ends.
# true + no external TURN: encoded WebSocket media through the HTTP tunnel.
HAUNT_CLOUDFLARED_ENABLED=false
# Optional external TURN service, e.g. an Oracle VM. IP/DNS only, no scheme/port.
# HAUNT_MEDIA_TURN_HOST=turn.example.test
# HAUNT_MEDIA_TURN_PORT=3478
# HAUNT_MEDIA_TURN_TLS_PORT=5349
# HAUNT_MEDIA_TURN_USERNAME=dedicated-relay-account
# HAUNT_MEDIA_TURN_PASSWORD=replace-with-relay-password
# Alternatively, Cloudflare Realtime TURN obtains temporary credentials.
# These are the Realtime TURN key ID/API token, not the cloudflared tunnel token.
# HAUNT_CLOUDFLARE_TURN_KEY_ID=replace-with-32-character-key-id
# HAUNT_CLOUDFLARE_TURN_API_TOKEN=replace-with-turn-key-api-token
# Use either the external TURN shortcut or Cloudflare TURN, not both.
# See docs/media-transports.md and deploy/compose.cloudflared.yml.

# SFU network configuration. On a public cloud VM set its mapped public IP
# and open the UDP range in the cloud network rules AND the host firewall.
# HAUNT_MEDIA_PUBLIC_IP=198.51.100.10
# HAUNT_MEDIA_PORT_MIN=50000
# HAUNT_MEDIA_PORT_MAX=50999
HAUNT_MEDIA_MAX_PEERS=512
HAUNT_MEDIA_ROOM_LIMIT=16
# Optional externally operated STUN/TURN servers; valid JSON, no trailing values.
# HAUNT_ICE_SERVERS=[{"urls":["stun:stun.example.test:3478"]},{"urls":["turn:turn.example.test:3478?transport=udp"],"username":"account","credential":"secret"}]

# Optional host connectivity relay. This is an OPERATOR setting. Clients use
# call admission's ICE details automatically; no user-facing mode selection.
HAUNT_RELAY_ENABLED=false
# HAUNT_RELAY_PUBLIC_IP=198.51.100.10
# HAUNT_RELAY_PUBLIC_HOST=chat.example.test
# HAUNT_RELAY_LISTEN_ADDR=0.0.0.0:3478
# HAUNT_RELAY_BIND_IP=0.0.0.0
# HAUNT_RELAY_PORT_MIN=49160
# HAUNT_RELAY_PORT_MAX=49999
# HAUNT_RELAY_MAX_ALLOCATIONS=512
# HAUNT_RELAY_CREDENTIAL_MINUTES=30
# Optional TLS listener, with all three settings together:
# HAUNT_RELAY_TLS_ADDR=0.0.0.0:5349
# HAUNT_RELAY_TLS_CERT=/etc/chatxo/relay.crt
# HAUNT_RELAY_TLS_KEY=/etc/chatxo/relay.key
# Private relay peers are denied by default. Add only an explicit trusted range
# if needed for a private SFU/LAN. Link-local/metadata addresses remain denied.
# HAUNT_RELAY_ALLOWED_PEER_CIDRS=10.0.0.10/32

# Desktop release distribution (environment changes apply on restart).
# An external HTTPS manifest takes precedence over local distribution.
# HAUNT_CLIENT_UPDATE_MANIFEST_URL=https://downloads.example.test/haunt-updates.json
HAUNT_CLIENT_UPDATE_LOCAL=false
# Show available platform installer downloads in the web client, when LOCAL=true.
HAUNT_CLIENT_UPDATE_INSTALLERS=false
# Local signed releases live in HAUNT_DATA_DIR/client-updates/.
# See docs/client-updates.md for the verified importer and GitHub setup.

# Optional private GitHub audio plugin repository access (contents-read token file).
# HAUNT_AUDIO_PLUGIN_GITHUB_TOKEN_FILE=/run/secrets/audio-plugin-token
# Seed the bundled RNNoise plugin only when no plugin has been installed.
HAUNT_DEFAULT_AUDIO_PLUGIN=true
